# ==============================================================================
# Production .htaccess for Root / Shared Hosting / Subfolder Deployments
# Redirects all incoming web traffic into backend/public while securing files
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    <IfModule mod_negotiation.c>
        Options -Indexes
    </IfModule>

    # Block sensitive files and directories from web access
    RewriteRule ^(\.git|\.env|\.user\.ini|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js) - [F,L,NC]
    RewriteRule ^(backend/(app|bootstrap|config|database|resources|routes|storage/framework|tests|vendor)) - [F,L,NC]
    RewriteRule ^(frontend/(src|node_modules)) - [F,L,NC]

    # Handle Authorization & XSRF Headers across internal rewrites
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Direct static assets (css, js, media, favicon, robots) whether accessed from root or subfolder
    RewriteRule ^(?:.+/)?(assets/.*)$ backend/public/$1 [L]
    RewriteRule ^(?:.+/)?(favicon\.ico|robots\.txt)$ backend/public/$1 [L]

    # Rewrite all traffic to backend/public directory (supports root & subfolder deployments)
    RewriteCond %{REQUEST_URI} !/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>

# Block access to hidden dotfiles (e.g. .env, .git)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block search engines from crawling or indexing
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>
