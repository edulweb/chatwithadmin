VITE_API_BASE_URL=https://api.your-domain.com/api/v1
VITE_STORAGE_URL=https://api.your-domain.com/storage

# Fallback broadcast connection if dynamic endpoint is unreachable: 'reverb' or 'pusher'
VITE_BROADCAST_CONNECTION=reverb

# Laravel Reverb
VITE_REVERB_APP_KEY=connectly-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Pusher Channels
VITE_PUSHER_APP_KEY=your-pusher-app-key
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
